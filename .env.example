# Copy to .env. Never commit .env.

# RPC for the fork tests, the deploy and launch scripts, and `make fork`. The public endpoint works for all of them.
# (The web app's browser side uses the public endpoint too, unless web/.env.local sets NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL.)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Only needed for `make deploy-sepolia` and `make launch-sepolia`: a fresh key funded with about 0.25 Base Sepolia ETH.
# It becomes the launch's issuer, curator and treasury. Accounts with code (EIP-7702 delegations) are refused.
# The 0x prefix is optional.
PRIVATE_KEY=

# Only for the backend's relayer (backend/README.md): its own key, never the one above. In web/,
# `npm run relayer:fund -- --new` creates it here and funds it from PRIVATE_KEY.
RELAYER_PRIVATE_KEY=

# Only needed to verify the contracts on Basescan.
BASESCAN_API_KEY=
