# What `vercel deploy` uploads from this repository: web/, Base Sepolia's public deployment records and the Playground's
# (its chains run on the backend, backend/), nothing else.
# Never .env, lib/, out/, broadcast/ or any other network's records.
/*
!/web
!/deployments
/deployments/*
!/deployments/84532.json
!/deployments/84532.runtime.json
!/deployments/84532.proof.json
!/deployments/84532-lp.proof.json
!/deployments/84532-manage.proof.json
!/deployments/playground.json
!/deployments/playground.runtime.json
/web/node_modules
/web/.next
/web/.chain
/web/.env*
/web/*.tsbuildinfo
